#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);
    int top=-1;
    int stack[100005];
    for(int i = 0; i < n; i++){
        int type;
        scanf("%d", &type);
        if(type==1) {
            int u;
            scanf("%d", &u);
            top++;
            stack[top] = u;
        }
        else if(type==2){
            if(top>=0) {
                top--;
            }
        }
        else if(type==3){
            if(top>=0) {
                printf("%d\n", stack[top]);
            }
            else {
                printf("Empty!\n");
            }
        }
    }
    return 0;
}

